{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "import/no-unresolved": ["error", { "caseSensitive": true }],
    "import/no-duplicates": "error",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  },
  "settings": {
    "import/resolver": {
      "typescript": { "project": "./tsconfig.json" }
    }
  }
}
