# =====================================================================
# Copy this file to .env.local and paste your own project values.
# =====================================================================

# --- Required by the app itself (browser + server) --------------------
# Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Required only by the maintenance scripts in scripts/ -------------
# These bypass Row Level Security. Never expose them to the browser and
# never prefix them with NEXT_PUBLIC_.
#
#   npm run db:seed-user   scripts/seed-test-user.mjs
#   npm run db:seed        scripts/seed-demo-data.mjs
# Supabase Dashboard -> Project Settings -> API -> service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

#   npm run db:schema      scripts/apply-schema.mjs
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.your-project-ref.supabase.co:5432/postgres

# --- Optional: AI LinkedIn Assistant (docs/perbaikan/02) --------------
# Server-only — never prefix with NEXT_PUBLIC_. Without this key the
# /skm/linkedin page keeps working with the deterministic template.
# Google AI Studio -> Get API key. Also used by scripts/ingest-branding-kb.mjs.
GEMINI_API_KEY=your-gemini-api-key
# Optional override for the generation model (default: gemini-3.7-flash).
# GEMINI_MODEL=gemini-3.7-flash
